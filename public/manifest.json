{
  "manifest_version": 3,
  "name": "Daily Workout Tracker",
  "version": "1.0.0",
  "description": "Track your daily workout consistency right from your browser.",
  "action": {
    "default_popup": "index.html",
    "default_icon": "img/png/icon32.png"
  },
  "icons": { 
    "16": "img/png/icon16.png",
    "32": "img/png/icon32.png",
    "48": "img/png/icon64.png",
    "128": "img/png/icon128.png"
  },
  "permissions": [
    "storage"
  ]
}